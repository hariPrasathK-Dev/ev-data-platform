# EV Charging Station Analytics - .gitignore

# ============================================================================
# Python
# ============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
venv/
env/
ENV/
.venv

# ============================================================================
# Backend
# ============================================================================
backend/__pycache__/
backend/*.log
backend/derby.log
backend/metastore_db/
backend/backend.log

# ============================================================================
# Node / Frontend
# ============================================================================
node_modules/
frontend/node_modules/
frontend/.svelte-kit/
frontend/build/
frontend/.vercel/
frontend/.env
frontend/.env.local
frontend/package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ============================================================================
# Java / MapReduce
# ============================================================================
*.class
mapreduce/classes/
*.jar
!mapreduce/*.jar
target/
.mvn/
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# ============================================================================
# Hadoop / Hive
# ============================================================================
metastore_db/
derby.log
hive/metastore_db/
hadoop-*.log
*.log
last_run_info.txt

# ============================================================================
# Data Files (Large CSVs)
# ============================================================================
# Large datasets - exclude from Git due to size limits
*.csv
ev_charging_station_data.csv
ev_charging_station_data_cleaned.csv

# Keep small sample files
!sample_data.csv

# ============================================================================
# IDE / Editors
# ============================================================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.project
.classpath
.settings/
*.iml

# ============================================================================
# OS
# ============================================================================
Thumbs.db
Desktop.ini
.DS_Store
.AppleDouble
.LSOverride

# ============================================================================
# Temporary Files
# ============================================================================
*.tmp
*.bak
*.backup
*~
.~lock.*

# ============================================================================
# Jupyter Notebooks
# ============================================================================
.ipynb_checkpoints/
*.ipynb_checkpoints

# ============================================================================
# Environment Variables
# ============================================================================
.env
.env.local
.env.production
.env.test

# ============================================================================
# Test Coverage
# ============================================================================
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# ============================================================================
# Documentation Build
# ============================================================================
docs/_build/
site/

# ============================================================================
# Project-Specific Ignores
# ============================================================================
# Temporary analysis outputs
output_*.txt
analysis_results/
temp_results/

# Large result files
job*_results.txt
*_output.txt

# System metadata
.Trash-*/

# Test and temporary scripts
test_*.sh
test_*.py
test_*.json
start_*.sh

# PySpark ML outputs (keep structure, ignore cached data)
pyspark-ml/venv/
pyspark-ml/test_*.py
pyspark-ml/*.pyc

# Spark Scala build artifacts
spark-scala/*.class
spark-scala/lib/
spark-scala/project/
spark-scala/target/

# HBase temporary files
hbase/*.class
hbase/sample_puts.hql

# Processed data outputs (large files)
data/processed/

# ============================================================================
# Keep Important Files
# ============================================================================
# Explicitly keep these files even if ignored by patterns above
!README.md
!PRESENTATION_CONTENT.md
!.gitignore
!requirements.txt
!package.json

# Keep all shell scripts
!*.sh

# Keep all HQL files
!*.hql

# Keep Java source files
!*.java

# Keep configuration files
!*.json
!*.config.js

# Keep JAR files in mapreduce directory
!mapreduce/StationUtilizationAnalysis.jar
!mapreduce/WeatherImpactAnalysis.jar
!mapreduce/StationReliabilityAnalysis.jar
